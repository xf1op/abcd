{
  "manifest_version": 3,
  "name": "RoValra Local",
  "short_name": "RoValra Local",
  "version": "0.4.7",
  "description": "Local homepage cleanup, optional compact sidebar and customizable Roblox navigation.",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "RoValra Local",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.roblox.com/*"
      ],
      "js": [
        "home-feed-filter.js",
        "accessory-limit.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.roblox.com/*"
      ],
      "js": [
        "home-feed-bridge.js",
        "sidebar-collapse.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ]
}
