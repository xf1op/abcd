{
  "manifest_version": 3,
  "name": "RoValra Local",
  "short_name": "RoValra Local",
  "version": "0.3.5",
  "description": "A lightweight, local-first Roblox quality-of-life extension with feed cleanup.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://avatar.roblox.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "RoValra Local",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.roblox.com/*"
      ],
      "js": [
        "home-feed-filter.js",
        "accessory-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.roblox.com/*"
      ],
      "js": [
        "home-feed-bridge.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "https://www.roblox.com/*"
      ],
      "js": [
        "accessory-manager.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ]
}
